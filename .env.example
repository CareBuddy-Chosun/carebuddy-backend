# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
POSTGRES_USER=carebuddy
POSTGRES_PASSWORD=carebuddy_password
POSTGRES_DB=carebuddy_db
DATABASE_URL=postgresql+asyncpg://carebuddy:carebuddy_password@db:5432/carebuddy_db

# Redis
REDIS_URL=redis://redis:6379

# LLM Settings — change provider/model here, no code changes needed
# Supported LLM_PROVIDER: openai, google, anthropic
LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=300

# STT provider: openai (Whisper) or google (Gemini multimodal)
STT_PROVIDER=google

# API Keys — only the key matching your provider is required
OPENAI_API_KEY=
GOOGLE_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=

# ElevenLabs TTS
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Vector DB
FAISS_INDEX_PATH=./faiss_index

# Twilio (Guardian notification)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
