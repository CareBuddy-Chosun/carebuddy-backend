# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database — MVP uses SQLite (requirements ship aiosqlite, not asyncpg).
# The POSTGRES_* vars below are only consumed by docker-compose's (vestigial) db service.
DATABASE_URL=sqlite+aiosqlite:////app/carebuddy.db
POSTGRES_USER=carebuddy
POSTGRES_PASSWORD=carebuddy_password
POSTGRES_DB=carebuddy_db

# Redis
REDIS_URL=redis://redis:6379

# LLM — OpenAI-compatible endpoint (OpenAI / Ollama / LM Studio).
# For LM Studio from inside Docker use host.docker.internal; pick a model that emits
# plain `content` (gemma-2-9b works; qwen3.5-4b is reasoning-only and returns empty content).
OPENAI_API_KEY=lm-studio
OPENAI_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=google/gemma-2-9b

# Maps — Naver Developers (Local Search) — REQUIRED for hospital search
NAVER_CLIENT_ID=your-naver-developers-client-id
NAVER_CLIENT_SECRET=your-naver-developers-client-secret

# Maps — Naver Cloud Platform (Reverse Geocoding) — OPTIONAL (location-aware search).
# Subscribe "Reverse Geocoding" under NCP > Maps; uses the maps.apigw.ntruss.com host.
# Blank => hospital search falls back to a plain nationwide keyword query.
NAVER_MAPS_KEY_ID=your-ncp-maps-key-id
NAVER_MAPS_KEY=your-ncp-maps-key

# TTS — edge-tts (free, no API key). Default voice ko-KR-SunHiNeural.

# Vector DB
FAISS_INDEX_PATH=./faiss_index
